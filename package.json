{
  "name": "@iuuuuuuuu/agent-notes",
  "version": "0.9.1",
  "description": "DSH 决策笔记（Agent Notes）：把「为什么这样改、放弃了什么」沉淀成可机械校验的仓库笔记，提供 Skill、会话级开关、真门禁与上游合并。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "tools",
    "cordis.patch.yml",
    "upstream.json",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-modules"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-notes",
    "decision-record",
    "adr",
    "skill"
  ],
  "license": "MIT",
  "author": "iuuuuuuuu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iuuuuuuuu/dsh-agent-notes.git"
  },
  "homepage": "https://github.com/iuuuuuuuu/dsh-agent-notes#readme",
  "bugs": {
    "url": "https://github.com/iuuuuuuuu/dsh-agent-notes/issues"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tools/*.test.mjs",
    "sync": "node tools/sync-upstream.mjs",
    "sync:check": "node tools/sync-upstream.mjs --check",
    "verify": "node tools/verify-plugin.mjs",
    "gate:fault-injection": "node tools/fault-injection.mjs",
    "notes:gate": "node tools/verify-notes.mjs",
    "notes:coverage": "node tools/notes-coverage.mjs",
    "notes:supersession": "node tools/notes-supersession.mjs",
    "archive:note": "node tools/archive-note.mjs",
    "doc:budget": "node tools/doc-budget.mjs",
    "notices": "node tools/notices.mjs",
    "notices:check": "node tools/notices.mjs --check",
    "md:links": "node tools/md-links.mjs",
    "doc:refs": "node tools/doc-refs.mjs",
    "corpus:floor": "node tools/corpus-floor.mjs",
    "publish:layout": "node tools/publish-layout.mjs",
    "board:selectors": "node tools/board-selector-alignment.mjs",
    "ci:align": "node tools/ci-alignment.mjs",
    "text:integrity": "node tools/text-integrity.mjs",
    "eol": "node tools/eol.mjs",
    "syntax:check": "node tools/syntax-check.mjs",
    "docs:bilingual": "node tools/bilingual-docs.mjs",
    "docs:links": "node tools/bilingual-links.mjs --check",
    "release:check": "node tools/release-check.mjs",
    "hooks:install": "node tools/install-hooks.mjs",
    "evidence": "node tools/live-evidence.mjs",
    "check": "npm run verify && npm run notices:check && npm run md:links && npm run doc:refs && npm run corpus:floor && npm run publish:layout && npm run board:selectors && npm run ci:align && npm run docs:bilingual && npm run docs:links && npm run text:integrity && npm run eol && npm run syntax:check && npm run release:check && npm run notes:gate && npm run notes:coverage:last && npm run notes:supersession:last && npm run doc:budget && npm test && npm run gate:fault-injection",
    "check:full": "npm run check && npm run evidence",
    "notes:coverage:last": "node tools/notes-coverage.mjs --range HEAD~1..HEAD",
    "notes:supersession:last": "node tools/notes-supersession.mjs --range HEAD~1..HEAD",
    "sync:latest": "node tools/sync-upstream.mjs --latest",
    "docs:fix-links": "node tools/bilingual-links.mjs"
  },
  "devDependencies": {
    "spdx-expression-parse": "^5.0.0"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.1.0"
  }
}
